rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.occupation is string && data.occupation in [
          'Farmer', 'Student', 'Professional', 'Driver', 'Outdoor Worker', 'Homemaker', 'Traveler', 'Other'
        ]
        && data.preferredUnit is string && data.preferredUnit in ['celsius', 'fahrenheit']
        && data.defaultLocation is map
        && data.defaultLocation.name is string && data.defaultLocation.name.size() <= 100
        && data.defaultLocation.country is string && data.defaultLocation.country.size() <= 100
        && data.defaultLocation.latitude is number
        && data.defaultLocation.longitude is number;
    }

    // Saved Location Validation
    function isValidSavedLocation(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.country is string && data.country.size() <= 100
        && data.latitude is number
        && data.longitude is number;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot be queried as a list
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      // Subcollection for Saved Locations
      match /savedLocations/{locationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(locationId)
          && isValidSavedLocation(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidId(locationId)
          && isValidSavedLocation(request.resource.data, userId)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(locationId);
      }
    }

    // Allow testing connection on app startup
    match /test/connection {
      allow get: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
