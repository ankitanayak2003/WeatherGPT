{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personalized occupation heuristics and weather settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Full display name" },
        "email": { "type": "string", "format": "email", "maxLength": 150, "description": "User email address" },
        "occupation": {
          "type": "string",
          "enum": [
            "Farmer",
            "Student",
            "Professional",
            "Driver",
            "Outdoor Worker",
            "Homemaker",
            "Traveler",
            "Other"
          ],
          "description": "User occupation used for personalized meteorological advice"
        },
        "preferredUnit": {
          "type": "string",
          "enum": ["celsius", "fahrenheit"],
          "description": "Preferred temperature unit"
        },
        "defaultLocation": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 100 },
            "region": { "type": "string", "maxLength": 100 },
            "country": { "type": "string", "maxLength": 100 },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          },
          "required": ["name", "country", "latitude", "longitude"]
        },
        "createdAt": { "type": "string", "description": "ISO timestamp or server time" },
        "updatedAt": { "type": "string", "description": "ISO timestamp or server time" }
      },
      "required": ["uid", "name", "email", "occupation", "preferredUnit", "defaultLocation"]
    },
    "SavedLocation": {
      "title": "SavedLocation",
      "description": "Saved favorite weather tracking location for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name", "country", "latitude", "longitude"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and weather personalization settings"
    },
    "/users/{userId}/savedLocations/{locationId}": {
      "schema": "SavedLocation",
      "description": "Subcollection of saved locations bookmarked by the user"
    }
  }
}
